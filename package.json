    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-admin": "^13.10.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
