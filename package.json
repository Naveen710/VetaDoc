{
  "name": "vetadoc",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "npm --prefix functions run build && firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/\"",
